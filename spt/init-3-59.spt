
 set minimizationCriterion 0.005;

 set zshade ON;
 set zShadePower 1;

  set picking OFF;
  color selectionHalos [x7ddfff]

  set measurement OFF;
  set showMeasurements OFF;
 
 set antialiasDisplay on;

 set antialiasImages ON;

 set labelOffset 0 0; 
 font labels 18; 
 set fontscaling TRUE;
 color labels black;

  font echo 28; 
 color echo [xA4031F];

//   color selectionHalos [X66ff66] ;

 select all and not _Xx; 
spacefill 26%;
wireframe 0.15;
color atoms translucent 0.0;

 hover off;
 
 background [xffffff]

 frank off;

 rotate best;
 
 zoom 0;

 zoomto 0.0 out;



